# ============================================================================
#  Sedmý les — proměnné prostředí
#  Zkopíruj do .env.local a vyplň. .env.local se necommituje.
# ============================================================================

# --- Databáze ---
# BEZ těchto proměnných běží web na lokálním PGlite (Postgres ve WASM, data
# v .pglite/). Nic se neinstaluje, `npm run dev` prostě funguje — ale data
# jsou jen na tvém disku. NA PRODUKCI JSOU POVINNÉ.
#
# Supabase dává dvě adresy a obě jsou potřeba:
#   · 6543 transakční pooler → běh aplikace. Nesnáší připravené dotazy,
#     proto driver jede s `prepare: false`.
#   · 5432 přímé spojení → migrace a seed. DDL a zámky přes pooler
#     spolehlivě neprojdou.
# Najdeš je v Project Settings → Database → Connection string.
#
# DATABASE_URL=postgresql://postgres.<ref>:<heslo>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# DIRECT_URL=postgresql://postgres.<ref>:<heslo>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#
# Po vyplnění: npm run db:setup (migrace + ceník + kontrola)
# Funguje i Neon — je to obyčejný Postgres, jen bez děleného poolu.

# --- SMTP pro odesílání poptávek (rezervace + kontakt) ---
# Bez vyplnění se poptávky jen logují do konzole — web funguje dál.
SMTP_HOST=smtp.forpsi.com
SMTP_PORT=465
SMTP_USER=ahoj@sedmyles.cz
SMTP_PASS=
CONTACT_TO=ahoj@sedmyles.cz

# ============================================================================
#  Připraveno pro další iterace (viz SYSTEM.md) — zatím se nepoužívá
# ============================================================================

# --- Bankovní spojení pro QR platbu (standard SPAYD / QR Platba ČBA) ---
# BANK_IBAN=CZ0000000000000000000000
# BANK_BIC=GIBACZPX
# BANK_DISPLAY=000000000/0800

# --- ComGate (platební brána) — doplnit až po zasmluvnění ---
# COMGATE_MERCHANT=
# COMGATE_SECRET=
# COMGATE_TEST=true

# --- Podpisové klíče ---
# PAYMENTS_SIGNING_KEY je NA PRODUKCI POVINNÝ. Bez něj se odkazy na platební
# stránku vůbec negenerují (raději žádný odkaz než odkaz, který si kdokoli
# spočítá) a host dostane platební údaje jen e-mailem.
# Vygeneruj: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# PAYMENTS_SIGNING_KEY=
# PORTAL_SECRET=          # HMAC pro přístupy hostů do portálu
# DATA_ENC_KEY=           # AES-256-GCM pro čísla dokladů v knize hostů
# CRON_SECRET=            # ochrana /api/cron/*

# --- Luna 5.6 (vyhodnocení fotoprotokolu) ---
# ANTHROPIC_API_KEY=
